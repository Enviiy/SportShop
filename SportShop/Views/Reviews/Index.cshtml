@model IEnumerable<SportShop.Domain.Entities.Review>
@{
    ViewBag.Title = "Отзывы";
}

<h2>Отзывы</h2>
<hr>

<a asp-action="Create" class="btn btn-warning">Оставить отзыв</a>

<div class="mb-5 mt-4">
    <div class="row g-4">
        @foreach (var r in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm bg-white p-3">
                    <div class="text-warning mb-2">
                        @for (int i = 0; i < r.Rating; i++)
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                    </div>
                    <p>"@r.Text"</p>
                    <b>@(r.AuthorName ?? "Аноним")</b>
                </div>
            </div>
        }
    </div>
    @if (!Model.Any())
    {
        <p class="text-muted">Пока нет одобренных отзывов.</p>
    }
</div>