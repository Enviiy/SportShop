@model SportShop.Domain.Entities.Category
@{
    ViewBag.Title = Model.Id == 0 ? "Добавить категорию" : "Редактировать категорию";
}
<div class="box">
    <h2>@ViewBag.Title</h2>
    <form asp-action="CategoriesEdit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DateCreated" />

        <div>
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title"></span>
        </div>

        <button type="submit">Сохранить</button>
        <a asp-action="Categories">Отмена</a>
    </form>
</div>