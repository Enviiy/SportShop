@model IEnumerable<SportShop.Domain.Entities.Brand>
@{
    ViewBag.Title = "Бренды";
}

<h2>Бренды</h2>
<hr/>

@if (TempData["Error"] != null)
{
    <p style="color:#c00">@TempData["Error"]</p>
}

<p><a class="text-black" asp-action="BrandsEdit" asp-route-id="0">Добавить бренд</a></p>

<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Логотип</th>
            <th scope="col">Название</th>
            <th scope="col">Описание</th>
            <th scope="col">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Id</td>
                <td>
                    @if (!string.IsNullOrEmpty(b.Logo))
                    {
                        <img src="~/img/@b.Logo" alt="@b.Title" style="max-height:40px" />
                    }
                </td>
                <td>@b.Title</td>
                <td>@b.Description</td>
                <td>
                    <a class="btn btn-primary" asp-action="BrandsEdit" asp-route-id="@b.Id">Редактировать</a>
                    <form asp-action="BrandsDelete" method="post" style="display:inline"
                            onsubmit="return confirm('Удалить бренд?');">
                        <input type="hidden" name="id" value="@b.Id" />
                        <button class="btn btn-danger" type="submit">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>