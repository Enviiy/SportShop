@model IEnumerable<SportShop.Domain.Entities.Review>
@{ ViewBag.Title = "Модерация отзывов"; }

<h2>Отзывы</h2>
<hr/>

<table class="table">
    <thead>
        <tr>
            <th scope="col">ID</th>
            <th scope="col">Автор</th>
            <th scope="col">Текст</th>
            <th scope="col">Рейтинг</th>
            <th scope="col">Статус</th>
            <th scope="col">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.AuthorName</td>
                <td>@r.Text</td>
                <td>@r.Rating</td>
                <td>@(r.IsApproved ? "Одобрен" : "На модерации")</td>
                <td>
                    @if (!r.IsApproved)
                    {
                        <form asp-action="ApproveReview" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button class="btn btn-primary" type="submit">Одобрить</button>
                        </form>
                    }
                    <form asp-action="DeleteReview" method="post" style="display:inline"
                            onsubmit="return confirm('Удалить отзыв?');">
                        <input type="hidden" name="id" value="@r.Id" />
                        <button class="btn btn-danger" type="submit">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>