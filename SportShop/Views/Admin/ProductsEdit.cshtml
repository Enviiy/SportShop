@model SportShop.Domain.Entities.Product
@{
    ViewBag.Title = Model.Id == 0 ? "Добавить товар" : "Редактировать товар";
    var categories = (IEnumerable<SportShop.Domain.Entities.Category>)ViewBag.Categories;
    var brands = (IEnumerable<SportShop.Domain.Entities.Brand>)ViewBag.Brands;
}
<div class="box">
    <h2>@ViewBag.Title</h2>
    <form asp-action="ProductsEdit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DateCreated" />

        <div><label asp-for="Title"></label><input asp-for="Title" /><span asp-validation-for="Title"></span></div>

        <div>
            <label asp-for="CategoryId"></label>
            <select asp-for="CategoryId">
                <option value="">—</option>
                @foreach (var c in categories)
                { <option value="@c.Id">@c.Title</option> }
            </select>
        </div>

        <div>
            <label asp-for="BrandId"></label>
            <select asp-for="BrandId">
                <option value="">—</option>
                @foreach (var b in brands)
                { <option value="@b.Id">@b.Title</option> }
            </select>
        </div>

        <div><label asp-for="Price"></label><input asp-for="Price" type="number" step="0.01" /></div>
        <div><label asp-for="OldPrice"></label><input asp-for="OldPrice" type="number" step="0.01" /></div>
        <div><label asp-for="Size"></label><input asp-for="Size" /></div>
        <div><label asp-for="ShortDescription"></label><textarea asp-for="ShortDescription"></textarea></div>
        <div><label asp-for="Description"></label><textarea asp-for="Description" rows="10"></textarea></div>

        <div>
            <label asp-for="Type"></label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<SportShop.Domain.Enums.ProductTypeEnum>()"></select>
        </div>

        <div><label>Фото</label><input type="file" name="imageFile" /></div>
        @if (!string.IsNullOrEmpty(Model.Photo))
        {
            <img src="~/img/@Model.Photo" style="display:block;margin:0 auto;max-width:100%;" />
        }

        <div><label><input asp-for="IsPromo" /> Акция</label></div>
        <div><label><input asp-for="IsNew" /> Новинка</label></div>
        <div><label><input asp-for="InStock" /> В наличии</label></div>

        <button type="submit">Сохранить</button>
        <a asp-action="Products">Отмена</a>
    </form>
</div>