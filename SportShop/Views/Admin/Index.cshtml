@{ ViewBag.Title = "Панель администратора"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Панель управления</h2>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-outline-danger">Выйти</button>
    </form>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <a asp-action="Products" class="text-decoration-none">
            <div class="card bg-primary text-white h-100 shadow border-0">
                <div class="card-body text-center py-5">
                    <i class="bi bi-box-seam display-4"></i>
                    <h4 class="mt-3">Товары</h4>
                    <h2 class="fw-bold">@ViewBag.ProductsCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a asp-action="Orders" class="text-decoration-none">
            <div class="card bg-success text-white h-100 shadow border-0">
                <div class="card-body text-center py-5">
                    <i class="bi bi-receipt display-4"></i>
                    <h4 class="mt-3">Заказы</h4>
                    <h2 class="fw-bold">@ViewBag.OrdersCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-4">
        <a asp-action="Reviews" class="text-decoration-none">
            <div class="card bg-warning text-dark h-100 shadow border-0">
                <div class="card-body text-center py-5">
                    <i class="bi bi-chat-left-text display-4"></i>
                    <h4 class="mt-3">Отзывы (на модерации)</h4>
                    <h2 class="fw-bold">@ViewBag.ReviewsCount</h2>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Categories" class="text-decoration-none">
            <div class="card bg-secondary text-white h-100 shadow border-0">
                <div class="card-body text-center">
                    <h5>Категории</h5>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Brands" class="text-decoration-none">
            <div class="card bg-secondary text-white h-100 shadow border-0">
                <div class="card-body text-center">
                    <h5>Бренды</h5>
                </div>
            </div>
        </a>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4">
            <a asp-action="Users" class="text-decoration-none">
                <div class="card bg-danger text-white h-100 shadow border-0">
                    <div class="card-body text-center">
                        <h5>Пользователи</h5>
                    </div>
                </div>
            </a>
        </div>
    }
</div>