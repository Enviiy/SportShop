@model IEnumerable<SportShop.Domain.Entities.Category>
@{
    ViewBag.Title = "Категории";
}

<h2>Категории</h2>
<hr/>

@if (TempData["Error"] != null)
{
    <p style="color:#c00">@TempData["Error"]</p>
}

<p><a class="text-black" asp-action="CategoriesEdit" asp-route-id="0">Добавить категорию</a></p>

<table>
    <thead>
        <tr><th>ID</th><th>Название</th><th>Дата создания</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Title</td>
                <td>@c.DateCreated.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="CategoriesEdit" asp-route-id="@c.Id">Ред.</a>
                    <form asp-action="CategoriesDelete" method="post" style="display:inline"
                            onsubmit="return confirm('Удалить категорию?');">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit">Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>