@model SportShop.Domain.Entities.Brand
@{
    ViewBag.Title = Model.Id == 0 ? "Добавить бренд" : "Редактировать бренд";
}
<div class="box container mt-4" style="max-width: 600px;">
    <h2 class="fw-bold mb-4">@ViewBag.Title</h2>


    <form asp-action="BrandsEdit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="DateCreated" />


        <input type="hidden" asp-for="Logo" />

        <div class="mb-3">
            <label asp-for="Title" class="form-label fw-bold">Название бренда</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label fw-bold">Описание</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Логотип бренда (картинка)</label>

            <input type="file" name="logoFile" class="form-control" accept="image/*" />

            @if (!string.IsNullOrEmpty(Model.Logo))
            {
                <div class="mt-3 p-2 border rounded text-center bg-light">
                    <p class="text-muted small mb-1">Текущий логотип:</p>
                    <img src="~/img/@Model.Logo" alt="@Model.Title" style="max-height: 100px; object-fit: contain;" />
                </div>
            }
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-warning fw-bold">Сохранить</button>
            <a asp-action="Brands" class="btn btn-outline-secondary">Отмена</a>
        </div>
    </form>
</div>