@model SportShop.Domain.Entities.Brand
@{
    ViewBag.Title = Model.Title;
    var products = (IEnumerable<SportShop.Models.ProductDto>)ViewBag.Products;
}

<div class="d-flex align-items-center mb-4 p-4 bg-light rounded shadow-sm">
    @if (!string.IsNullOrEmpty(Model.Logo))
    {
        <img src="~/img/@Model.Logo" alt="@Model.Title" class="me-4 rounded" style="max-height: 120px; max-width: 200px; object-fit: contain;" />
    }
    
    <div>
        <h2 class="fw-bold mb-1">@Model.Title</h2>
        <p class="text-muted mb-0">@Model.Description</p>
    </div>
</div>

<hr />
<h3 class="mb-4">Товары бренда:</h3>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @if (!products.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">У этого бренда пока нет товаров.</div>
        </div>
    }
    else
    {
        @foreach (var p in products)
        {
            <div class="col">
                <div class="card h-100 product-card shadow-sm border-0">
                    <a asp-controller="Products" asp-action="Show" asp-route-id="@p.Id">
                        <img src="~/img/@(p.Photo ?? "placeholder.jpg")" class="card-img-top" alt="@p.Title" style="height: 250px; object-fit: cover;">
                    </a>
                    <div class="card-body d-flex flex-column">
                        <small class="text-muted text-uppercase">@p.BrandName</small>
                        <h5 class="card-title text-black fw-bold">
                            <a asp-controller="Products" asp-action="Show" asp-route-id="@p.Id" class="text-decoration-none text-black">@p.Title</a>
                        </h5>
                        <p class="card-text text-muted small">@p.ShortDescription</p>
                        <h4 class="card-text text-danger fw-bold mt-auto">@p.Price.ToString("C")</h4>
                    </div>
                    <div class="card-footer bg-white border-0 d-flex justify-content-between pb-3">
                        <a asp-action="Show" asp-controller="Products" asp-route-id="@p.Id" class="btn btn-outline-dark">Подробнее</a>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <button type="submit" class="btn btn-dark"><i class="bi bi-cart-plus"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>