@model SportShop.Domain.Entities.Brand
@{
    ViewBag.Title = Model.Title;
    var products = (IEnumerable<SportShop.Models.ProductDto>)ViewBag.Products;
}

<h2>@Model.Title</h2>
<hr />

<p>@Model.Description</p>
<h3>Товары бренда:</h3>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var p in products)
    {
        <div class="col">
            <a class="text-decoration-none" asp-controller="Products" asp-action="Show" asp-route-id="@p.Id">
                <div class="card h-100 product-card shadow-sm border-0">
                    <img src="~/img/@(p.Photo ?? "placeholder.jpg")" class="card-img-top" alt="@p.Title">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-black">@p.Title</h5>
                        <p class="card-text text-black">@p.BrandName</p>
                        <p class="card-text text-black">@p.ShortDescription</p>
                        <h4 class="card-text text-black">@p.Price.ToString("C")</h4>
                    </div>
                    <div class="card-footer bg-white border-0 d-flex justify-content-start gap-2">
                        <a asp-action="Show" asp-controller="Products" asp-route-id="@p.Id" class="btn btn-outline-dark">Подробнее</a>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <button type="submit" class="btn btn-dark">В корзину</button>
                        </form>
                    </div>
                </div>
            </a>
        </div>
    }
</div>