@model IEnumerable<SportShop.Domain.Entities.Brand>
@{
    ViewBag.Title = "Бренды";
}

<h2>Бренды</h2>
<hr>

<div class="col-lg-9">
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var b in Model)
        {
            <div class="col">
                <a class="text-decoration-none" asp-action="Show" asp-route-id="@b.Id">
                    <div class="card h-100 product-card shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-black">@b.Title</h5>
                            <p class="card-text text-black">@b.Description</p>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <a class="btn btn-primary" asp-action="Show" asp-route-id="@b.Id">Товары бренда</a>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>