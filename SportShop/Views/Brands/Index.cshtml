@model IEnumerable<SportShop.Domain.Entities.Brand>
@{
    ViewBag.Title = "Бренды";
}

<h2>Бренды</h2>
<hr>

<div class="col-lg-9">
    @if (!Model.Any())
    {
        <div class="alert alert-info">По вашему запросу ничего не найдено.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var b in Model)
            {
            <div class="col">
                <div class="card h-100 product-card shadow-sm border-0">
                    <!-- Блок с картинкой -->
                    <div class="text-center p-3" style="height: 160px; background-color: #f8f9fa;">
                        @if (!string.IsNullOrEmpty(b.Logo))
                        {
                            <img src="~/img/@b.Logo" class="img-fluid h-100" style="object-fit: contain;" alt="@b.Title" />
                        }
                        else
                        {
                            <!-- Заглушка, если логотипа нет -->
                            <img src="~/img/placeholder.jpg" class="img-fluid h-100" style="object-fit: contain; opacity: 0.5;" alt="Нет логотипа" />
                        }
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-black fw-bold">@b.Title</h5>
                        <p class="card-text text-muted small flex-grow-1">@b.Description</p>
                    </div>
                
                    <div class="card-footer bg-white border-0 pb-3">
                        <a class="btn btn-warning" asp-action="Show" asp-route-id="@b.Id">Товары бренда</a>
                    </div>
                </div>
            </div>
            }
        </div>
        }
</div>