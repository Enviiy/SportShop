@inject IConfiguration config
@{
    var appConfig = config.GetSection("Project").Get<SportShop.Infrastructure.AppConfig>();
}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <!-- Логотип -->
        <img src="\img\logo.png" width="50" />
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            @appConfig?.company.CompanyName
        </a>
        
        <!-- Кнопка мобильного меню -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <!-- Ссылки -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">О нас</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Каталог</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Promo">Акции</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="New">Новинки</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Brands" asp-action="Index">Бренды</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reviews" asp-action="Index">Отзывы</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contacts">Контакты</a></li>
            </ul>
            
            <ul class="navbar-nav">
                <!-- Корзина -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Корзина</a></li>
                }
                <!-- Личный кабинет -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@User.Identity.Name</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Профиль</a></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Orders">Мои заказы</a></li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Админ-панель</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">Выйти</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="btn btn-primary me-2" asp-controller="Account" asp-action="Login">Вход</a></li>
                    <li class="nav-item"><a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">Регистрация</a></li>
                }
            </ul>
        </div>
    </div>
</nav>