@inject IConfiguration config
@{
    var appConfig = config.GetSection("Project").Get<SportShop.Infrastructure.AppConfig>();
    ViewBag.Title = "Главная";
    var popular = (IEnumerable<SportShop.Models.ProductDto>)ViewBag.Popular;
    var promo   = (IEnumerable<SportShop.Models.ProductDto>)ViewBag.Promo;
    var reviews = (IEnumerable<SportShop.Domain.Entities.Review>)ViewBag.Reviews;
}

<!-- Баннер -->
<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow" style="background: url('https://images.unsplash.com/photo-1517836357463-d25dfeac3438?q=80&w=1200') no-repeat center center; background-size: cover;">
    <div class="container-fluid py-5" style="background: rgba(0,0,0,0.6); border-radius: 10px;">
        <h1 class="display-4 fw-bold">@appConfig?.company.CompanyName</h1>
        <p class="col-md-8 fs-4">Экипировка для тех, кто не останавливается на достигнутом.</p>
        <a class="btn btn-warning btn-lg fw-bold" asp-controller="Products" asp-action="Index">Перейти в каталог</a>
    </div>
</div>

<!-- Популярные товары -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Популярные товары</h2>
        <a asp-controller="Products" asp-action="Index" class="text-decoration-none">Смотреть все <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var p in popular)
        {
            <div class="col">
                <div class="card h-100 product-card shadow-sm border-0">
                    <img src="~/img/@(p.Photo ?? "placeholder.jpg")" class="card-img-top" alt="@p.Title" style="object-fit:cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@p.Title</h5>
                        <p class="text-muted small mb-2">@p.BrandName</p>
                        <h4 class="text-danger fw-bold mt-auto">@p.Price.ToString("C")</h4>
                    </div>
                    <div class="card-footer bg-white border-0 pb-3">
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <button type="submit" class="btn btn-dark w-100"><i class="bi bi-cart-plus"></i> В корзину</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Акции -->
@if (promo.Any())
{
    <div class="bg-warning bg-opacity-10 p-4 rounded-3 mb-5 border border-warning">
        <h2 class="fw-bold text-warning mb-4"><i class="bi bi-tags-fill"></i> Горячие акции</h2>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var p in promo)
            {
                <div class="col">
                    <div class="card h-100 product-card shadow-sm border-0">
                        <div class="position-absolute top-0 start-0 bg-danger text-white px-2 py-1 m-2 rounded small">SALE</div>
                        <img src="~/img/@(p.Photo ?? "placeholder.jpg")" class="card-img-top" alt="@p.Title">
                        <div class="card-body text-center">
                            <h5 class="card-title">@p.Title</h5>
                            <p><s class="text-muted">@p.OldPrice?.ToString("C")</s> <b class="text-danger fs-5">@p.Price.ToString("C")</b></p>
                            <a asp-controller="Products" asp-action="Show" asp-route-id="@p.Id" class="btn btn-outline-dark w-100">Подробнее</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Отзывы -->
<div class="mb-5">
    <h2 class="fw-bold mb-4">Отзывы клиентов</h2>
    <div class="row g-4">
        @foreach (var r in reviews)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm bg-white p-3">
                    <div class="text-warning mb-2">
                        @for (int i = 0; i < r.Rating; i++) { <i class="bi bi-star-fill"></i> }
                    </div>
                    <p class="fst-italic">"@r.Text"</p>
                    <p class="fw-bold mb-0">— @r.AuthorName</p>
                </div>
            </div>
        }
    </div>
    <div class="text-center mt-4">
        <a asp-controller="Reviews" asp-action="Index" class="btn btn-outline-dark">Все отзывы</a>
    </div>
</div>