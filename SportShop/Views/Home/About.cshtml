@inject IConfiguration config
@{
    var appConfig = config.GetSection("Project").Get<SportShop.Infrastructure.AppConfig>();
    ViewBag.Title = "О нас";
}

<div class="box">
    <h2>О компании @appConfig?.company.CompanyName</h2>
    <p>
        Мы — команда энтузиастов спорта, создающая магазин, в котором каждый найдёт
        одежду для тренировок, соревнований и активного отдыха. Наша миссия —
        сделать качественную экипировку доступной.
    </p>
    <h3>Преимущества</h3>
    <ul>
        <li>Только оригинальные бренды</li>
        <li>Быстрая доставка по всей России</li>
        <li>Гарантия возврата в течение 14 дней</li>
        <li>Скидки постоянным клиентам</li>
    </ul>
</div>