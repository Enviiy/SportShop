@inject IConfiguration config
@{
    var appConfig = config.GetSection("Project").Get<SportShop.Infrastructure.AppConfig>();
    ViewBag.Title = "Контакты";
}

<h2>Контактная информация</h2>
<hr>

<p>Телефон: <a href="tel:@appConfig?.company.CompanyPhoneShort" class="text-black">@appConfig?.company.CompanyPhone</a></p>
<p>Email: <a href="mailto:@appConfig?.company.CompanyEmail" class="text-black">@appConfig?.company.CompanyEmail</a></p>

<h2>Форма обратной связи</h2>
<hr>

<form method="post" asp-controller="Home" asp-action="Feedback">
    <div><label>Имя</label><input class="form-control" name="name" required /></div>
    <div><label>Email</label><input class="form-control" type="email" name="email" required /></div>
    <div><label>Сообщение</label><textarea class="form-control" name="message" required></textarea></div>
    <button class="btn btn-primary mt-3" type="submit">Отправить</button>
</form>
