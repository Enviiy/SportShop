@model IEnumerable<SportShop.Domain.Entities.Order>
@{
    ViewBag.Title = "Мои заказы";
}

<h2>Мои заказы</h2>
<hr/>

@if (!Model.Any())
{
    <p>У вас пока нет заказов</p>
    <a class="text-black" asp-controller="Products" asp-action="Index">Перейти в каталог</a>
}
else
{
    @foreach (var o in Model)
    {
        <article>
            <h3>@o.Title</h3>
            <p>Статус: <b>@o.Status</b></p>
            <p>Сумма: @o.Total.ToString("C")</p>
            <p>Товары:</p>
            <ul class="list-unstyled">
                @foreach (var i in o.Items)
                {
                    <li>@i.Product?.Title × @i.Quantity = @((i.Price * i.Quantity).ToString("C"))</li>
                }
            </ul>
        </article>
    }
}