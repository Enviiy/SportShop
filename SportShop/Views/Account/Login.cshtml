@model SportShop.Models.LoginViewModel
@{
    ViewBag.Title = "Вход";
}

<h2>Вход</h2>
<hr/>

<form asp-action="Login" method="post">
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
    <div asp-validation-summary="ModelOnly"></div>
    <div><label asp-for="UserName"></label><input class="form-control" asp-for="UserName" /><span asp-validation-for="UserName"></span></div>
    <div><label asp-for="Password"></label><input class="form-control" asp-for="Password" /><span asp-validation-for="Password"></span></div>
    <button class="btn btn-warning mt-3 mb-3" type="submit">Войти</button>
</form>
<p><a class="text-black" asp-action="Register">Нет аккаунта? Зарегистрироваться</a></p>