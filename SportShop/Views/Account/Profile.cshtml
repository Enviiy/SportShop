@model Microsoft.AspNetCore.Identity.IdentityUser
@{
    ViewBag.Title = "Личный кабинет";
}

<h2>Личный кабинет</h2>
<hr/>

<ul class="list-group list-group-flush">
    <li class="list-group-item">
        <h5>Email:</h5><p> @Model.Email</p>
    </li>
    <li class="list-group-item">
        <h5>Логин:</h5><p> @Model.UserName</p>
    </li>
    <li class="list-group-item">
        <h5>Перейти к заказам:</h5><a class="text-black" asp-action="Orders">Мои заказы</a><br />
    </li>
    <li class="list-group-item">
        <h5>Выйти из аккаунта:</h5>
        <form asp-action="Logout" method="post" style="display:inline">
            <button class="btn btn-danger" type="submit">Выйти</button>
        </form>
    </li>
    
</ul>