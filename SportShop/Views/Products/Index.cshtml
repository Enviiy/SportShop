@model IEnumerable<SportShop.Models.ProductDto>
@{
    ViewBag.Title = "Каталог";
    var categories = (IEnumerable<SportShop.Domain.Entities.Category>)ViewBag.Categories;
    var brands = (IEnumerable<SportShop.Domain.Entities.Brand>)ViewBag.Brands;
    int? curCat = ViewBag.CurrentCategory;
    int? curBrand = ViewBag.CurrentBrand;
    string? search = ViewBag.Search;
}

<h2>Каталог</h2>
<hr>

<div class="row">
    <!-- Сайдбар с фильтрами -->
    <div class="col-lg-3 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white">Фильтры</div>
            <div class="card-body">
                <form method="get" asp-action="Index">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Поиск</label>
                        <input name="search" value="@search" class="form-control" placeholder="Название товара..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Категория</label>
                        <select name="categoryId" class="form-select">
                            <option value="">Все категории</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id" selected="@(curCat == c.Id)">@c.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Бренд</label>
                        <select name="brandId" class="form-select">
                            <option value="">Все бренды</option>
                            @foreach (var b in brands)
                            {
                                <option value="@b.Id" selected="@(curBrand == b.Id)">@b.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Цена</label>
                        <div class="d-flex gap-2">
                            <input type="number" name="priceMin" placeholder="От" class="form-control" />
                            <input type="number" name="priceMax" placeholder="До" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Сортировка</label>
                        <select name="sort" class="form-select">
                            <option value="">По названию</option>
                            <option value="price_asc" selected="@(ViewBag.Sort == "price_asc")">Сначала дешевле</option>
                            <option value="price_desc" selected="@(ViewBag.Sort == "price_desc")">Сначала дороже</option>
                            <option value="new" selected="@(ViewBag.Sort == "new")">Новинки</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Применить</button>
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">Сбросить</a>
                </form>
            </div>
        </div>
    </div>

    <!-- Сетка товаров -->
    <div class="col-lg-9">
        <h2 class="mb-4">Спортивная одежда</h2>
        @if (!Model.Any())
        {
            <div class="alert alert-info">По вашему запросу ничего не найдено.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var p in Model)
                {
                    <div class="col">
                        <div class="card h-100 product-card shadow-sm border-0">
                            <img src="~/img/@(p.Photo ?? "placeholder.jpg")" class="card-img-top" alt="@p.Title">
                            <div class="card-body d-flex flex-column">
                                <small class="text-muted text-uppercase">@p.BrandName</small>
                                <h5 class="card-title fw-bold">@p.Title</h5>
                                <p class="card-text text-muted small">@p.ShortDescription</p>
                                <h4 class="text-danger fw-bold mt-auto">@p.Price.ToString("C")</h4>
                            </div>
                            <div class="card-footer bg-white border-0 d-flex justify-content-between">
                                <a asp-action="Show" asp-route-id="@p.Id" class="btn btn-outline-dark">Подробнее</a>
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <button type="submit" class="btn btn-dark"><i class="bi bi-cart-plus"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>