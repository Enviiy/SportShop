@model IEnumerable<SportShop.Models.ProductDto>
@{
    ViewBag.Title = "Новинки";
}

<h2>Новинки</h2>
<hr>

<div class="col-lg-9">
    @if (!Model.Any())
    {
        <div class="alert alert-info">По вашему запросу ничего не найдено.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var p in Model)
            {
                <div class="col">
                    <a class="text-decoration-none" asp-controller="Products" asp-action="Show" asp-route-id="@p.Id">
                        <div class="card h-100 product-card shadow-sm border-0">
                            <img src="~/img/@(p.Photo ?? "placeholder.jpg")" class="card-img-top" alt="@p.Title">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-black">@p.Title</h5>
                                <p class="card-text text-black">@p.BrandName</p>
                                <p class="card-text text-black">@p.ShortDescription</p>
                                <h4 class="card-text text-black">@p.Price.ToString("C")</h4>
                            </div>
                            <div class="card-footer bg-white border-0 d-flex justify-content-start">
                                <a asp-action="Show" asp-controller="Products" asp-route-id="@p.Id" class="btn btn-outline-warning me-3 text-black">Подробнее</a>
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <button type="submit" class="btn btn-warning">В корзину</button>
                                </form>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>