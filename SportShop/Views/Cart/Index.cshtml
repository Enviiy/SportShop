@model SportShop.Models.CartViewModel
@{
    ViewBag.Title = "Корзина";
}
<div class="box">
    <h2>Корзина</h2>
    @if (!Model.Items.Any())
    {
        <p>Корзина пуста. <a asp-controller="Products" asp-action="Index">Перейти в каталог</a></p>
    }
    else
    {
        <table>
            <thead>
                <tr><th>Товар</th><th>Цена</th><th>Кол-во</th><th>Сумма</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Product?.Title</td>
                        <td>@item.Product?.Price.ToString("C")</td>
                        <td>
                            <form asp-action="Update" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" />
                                <button type="submit">↻</button>
                            </form>
                        </td>
                        <td>@((item.Product?.Price * item.Quantity)?.ToString("C"))</td>
                        <td>
                            <form asp-action="Remove" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">Итого</th>
                    <th colspan="2">@Model.Total.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
        <p><a class="button" asp-action="Checkout">Оформить заказ</a></p>
    }
</div>